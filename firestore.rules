rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gerito.diseno@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['ip','country','city','timestamp','userAgent'])
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow create: if request.resource.data.keys().hasOnly(['ip','country','city','timestamp'])
                    && request.resource.data.timestamp == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if request.resource.data.get('public', false) == false
                    && request.resource.data.status == 'new'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 3000
                    && request.resource.data.createdAt == request.time;
      allow read: if resource.data.get('public', false) == true || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
